# Copy to .env.local. Never commit real values.

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Username of the professional Instagram bot account, without the @
NEXT_PUBLIC_INSTAGRAM_BOT_USERNAME=

# Public address of the app
NEXT_PUBLIC_SITE_URL=

# Meta Model API. Check prices at https://dev.meta.ai/docs/pricing-rate-limits
MODEL_API_KEY=
MODEL_API_BASE=
MODEL_EXTRACT=
MODEL_SEARCH=
MODEL_IMAGE=
PRICE_IMAGE_USD=
PRICE_INPUT_PER_MTOK=
PRICE_CACHED_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
PRICE_SEARCH_PER_1K=

# Spending and abuse limits
AI_BUDGET_USD=
MAX_REELS_PER_USER_PER_DAY=
MAX_ASKS_PER_USER_PER_DAY=
MAX_SEARCHES_PER_REEL=

# Instagram
# Instagram API with Unified Login.
# App secret: the Meta app secret from App settings > Basic. It signs webhooks.
INSTAGRAM_APP_SECRET=
# System-user token from API setup with Unified login > Generate access tokens
INSTAGRAM_ACCESS_TOKEN=
# The bot's Instagram account ID, shown under its username in Generate access tokens
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_API_VERSION=

# Enrichment. Leave blank to switch either one off.
TMDB_API_KEY=
# Two-letter country code for streaming availability
TMDB_REGION=
NOMINATIM_URL=

# Optional: signs public share links for lists. Without it, a key derived from the
# Supabase service key is used. Changing it turns off every shared link.
SHARE_LINK_SECRET=
